# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://dropify:password@localhost:5432/dropify

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=your_random_64_char_secret_here
NEXTAUTH_URL=https://yourdomain.com

# ─── Spotify ─────────────────────────────────────────────────────────────────
# Create app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Access Control ──────────────────────────────────────────────────────────
APP_ACCESS_MODE=public
ALLOWED_SPOTIFY_USER_IDS=spotify_user_id_1,spotify_user_id_2
ALLOWED_EMAILS=user@example.com

# ─── Resend (Email) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Dropify <notifications@yourdomain.com>

# ─── Web Push ────────────────────────────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:your@email.com

# ─── Cron Security ───────────────────────────────────────────────────────────
CRON_SECRET=your_random_secret_string_here
